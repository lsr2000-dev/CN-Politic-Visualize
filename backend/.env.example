# ===== local demo (JSON dataset, no database) =====
POLVIS_ENVIRONMENT=dev
POLVIS_DATA_MODE=json
POLVIS_REDIS_URL=

# ===== PostgreSQL mode =====
# POLVIS_DATA_MODE=postgres
# POLVIS_DATABASE_URL=postgresql+psycopg://polvis:polvis@127.0.0.1:5432/polvis

# ===== Redis (optional; falls back to in-process LRU) =====
# POLVIS_REDIS_URL=redis://127.0.0.1:6379/0

# ===== HTTP =====
POLVIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
POLVIS_CACHE_TTL_SECONDS=900
